# Supabase Project Configuration (Client-side Public Credentials)
# Get these from your Supabase Dashboard: Project Settings -> API

# Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public Anon API Key (safe to use in frontend code; protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# IMPORTANT SECURITY NOTE:
# NEVER place your Supabase service_role key here or in any frontend files!
# Only the public 'anon' key should be configured here.
